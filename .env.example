# --- App ---
# "mock" = synthetic dev data (refused in production). "synced" = daily-synced summaries from Postgres.
DATA_ADAPTER=mock

# --- Supabase (Postgres + Auth). Dashboard > Project Settings ---
# Pooled connection (port 6543) for the app, direct connection (port 5432) for migrations.
# Runtime connection. On a server that stays running, use the session-mode pooler (port 5432): a query takes about 35 ms instead of
# about 180 ms through the transaction pooler (port 6543). On serverless hosting, where many short-lived instances connect,
# use the transaction pooler instead: ...:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=8&pool_timeout=20
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Server-only. Lets admins invite people from Settings > User Management. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Public address of the site, used in the links inside emails. Leave unset locally (it is read from the request).
SITE_URL=
# Comma-separated emails that become Admin on first sign-in (everyone else starts as Member)
ADMIN_EMAILS=prateek.mishra@bizgroup.ae

# --- Dev-only login, ignored in production (lets you run without Supabase) ---
AUTH_DEV_LOGIN=true

# --- BigQuery (used only by the sync job; server-side only) ---
BQ_PROJECT_ID=
BQ_DATASET=axonify___bizgroup_emea
# Axonify tenant ids the dashboards cover, comma-separated
BQ_TENANT_IDS=
BQ_MAPPING_FILE=config/bigquery-mapping.json
# Local: set GOOGLE_APPLICATION_CREDENTIALS to a service-account key with BigQuery Data Viewer + Job User.
